<?xml version="1.0" encoding="utf-8"?>
<!-- Widget mediano 4 × 1 (W4): micrófono grafito, avatar y nombre del modelo (▾ abre «¿Con quién quieres hablar?»)
     y los botones Nuevo y Agenda con su nombre bajo el ícono (62 × 52). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_pill"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/widget_mic"
        style="@style/WidgetMic"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:padding="17dp" />

    <LinearLayout
        android:id="@+id/widget_model"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_preview_avatar" />

        <TextView
            android:id="@+id/widget_model_name"
            style="@style/WidgetModelName"
            android:layout_marginStart="8dp"
            android:drawableEnd="@drawable/widget_arrow_15"
            android:text="Sakura"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_buttons"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_new_chat"
            style="@style/WidgetButton"
            android:layout_width="62dp"
            android:contentDescription="@string/shortcut_new_chat">

            <ImageView
                android:id="@+id/widget_new_chat_icon"
                style="@style/WidgetButtonIcon"
                android:src="@drawable/ic_ui_chat_plus" />

            <TextView
                android:id="@+id/widget_new_chat_label"
                style="@style/WidgetButtonLabel"
                android:text="@string/widget_action_new" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_calendar"
            style="@style/WidgetButton"
            android:layout_width="62dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@string/widget_action_calendar">

            <ImageView
                android:id="@+id/widget_calendar_icon"
                style="@style/WidgetButtonIcon"
                android:src="@drawable/ic_ui_calendar" />

            <TextView
                android:id="@+id/widget_calendar_label"
                style="@style/WidgetButtonLabel"
                android:text="@string/widget_action_calendar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
