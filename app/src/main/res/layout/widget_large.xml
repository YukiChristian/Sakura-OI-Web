<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande 4 × 2 ("Widgets · 1, 3 y 8 modelos, con Notas y Calendario"): avatar, nombre del modelo (▾ abre
     «¿Con quién quieres hablar?») y el micrófono azul; la fila de avatares de los modelos (no aparece con uno solo;
     si no caben, el último lugar es «+N»); y la barra Nuevo · Calendario · Notas · Último. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_preview_avatar" />

        <LinearLayout
            android:id="@+id/widget_model"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_model_name"
                style="@style/WidgetModelName"
                android:drawableEnd="@drawable/widget_arrow_17"
                android:text="Sakura"
                android:textSize="19sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_mic"
            style="@style/WidgetMic"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:padding="15.5dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_slots"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_slot_0"
            style="@style/WidgetSlot"
            android:src="@drawable/widget_preview_slot_sakura" />

        <ImageView
            android:id="@+id/widget_slot_1"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:src="@drawable/widget_preview_slot_lain" />

        <ImageView
            android:id="@+id/widget_slot_2"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:src="@drawable/widget_preview_slot_yoko" />

        <ImageView
            android:id="@+id/widget_slot_3"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_4"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_5"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_6"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_bar"
        android:orientation="horizontal"
        android:padding="3dp">

        <LinearLayout
            android:id="@+id/widget_new_chat"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/shortcut_new_chat">

            <ImageView
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_chat_plus" />

            <TextView
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_new" />
        </LinearLayout>

        <ImageView style="@style/WidgetBarDivider" />

        <LinearLayout
            android:id="@+id/widget_calendar"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/widget_action_calendar">

            <ImageView
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_calendar" />

            <TextView
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_calendar" />
        </LinearLayout>

        <ImageView style="@style/WidgetBarDivider" />

        <LinearLayout
            android:id="@+id/widget_notes"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/widget_action_notes">

            <ImageView
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_notes" />

            <TextView
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_notes" />
        </LinearLayout>

        <ImageView style="@style/WidgetBarDivider" />

        <LinearLayout
            android:id="@+id/widget_last_chat"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/shortcut_last_chat">

            <ImageView
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_history" />

            <TextView
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_last" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
