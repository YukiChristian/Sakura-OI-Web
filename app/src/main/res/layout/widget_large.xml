<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande 4 × 2 (Hanami, W1–W3 y W6): avatar y nombre del modelo elegido (▾ abre «¿Con quién quieres
     hablar?»; sin ▾ con un solo modelo) y el micrófono grafito; la fila con los demás modelos (tocar uno lo pasa
     arriba; si no caben, «+N»); el aviso «Tu PC no responde»; y Nuevo chat · Agenda · Notas · Último chat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_preview_avatar" />

        <LinearLayout
            android:id="@+id/widget_model"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_model_name"
                style="@style/WidgetModelName"
                android:drawableEnd="@drawable/widget_arrow_17"
                android:text="Sakura"
                android:textSize="19sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_mic"
            style="@style/WidgetMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="17dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_slots"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_slot_0"
            style="@style/WidgetSlot"
            android:src="@drawable/widget_preview_slot_lain" />

        <ImageView
            android:id="@+id/widget_slot_1"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:src="@drawable/widget_preview_slot_yoko" />

        <ImageView
            android:id="@+id/widget_slot_2"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_3"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_4"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_5"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_slot_6"
            style="@style/WidgetSlot"
            android:layout_marginStart="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- «Tu PC no responde» (gone while the PC answers): why, what to do and Reintentar. -->
    <LinearLayout
        android:id="@+id/widget_offline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_warn_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="7dp"
        android:paddingEnd="8dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_monitor"
            android:tint="@color/widget_warn" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_offline_title"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="2"
                android:text="@string/widget_offline_text"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_retry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_retry"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/widget_retry"
            android:textColor="@color/widget_on_mic"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_bar"
        android:orientation="horizontal"
        android:padding="3dp">

        <LinearLayout
            android:id="@+id/widget_new_chat"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/shortcut_new_chat">

            <ImageView
                android:id="@+id/widget_new_chat_icon"
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_chat_plus" />

            <TextView
                android:id="@+id/widget_new_chat_label"
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_new_chat" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_calendar"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/widget_action_calendar">

            <ImageView
                android:id="@+id/widget_calendar_icon"
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_calendar" />

            <TextView
                android:id="@+id/widget_calendar_label"
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_calendar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_notes"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/widget_action_notes">

            <ImageView
                android:id="@+id/widget_notes_icon"
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_notes" />

            <TextView
                android:id="@+id/widget_notes_label"
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_notes" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_last_chat"
            style="@style/WidgetBarCell"
            android:contentDescription="@string/shortcut_last_chat">

            <ImageView
                android:id="@+id/widget_last_chat_icon"
                style="@style/WidgetBarIcon"
                android:src="@drawable/ic_ui_history" />

            <TextView
                android:id="@+id/widget_last_chat_label"
                style="@style/WidgetBarLabel"
                android:text="@string/widget_action_last" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
