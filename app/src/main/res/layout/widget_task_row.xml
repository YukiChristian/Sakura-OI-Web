<?xml version="1.0" encoding="utf-8"?>
<!-- Una tarea de «Pendientes»: casilla de 48 dp (la completa sin abrir la app), título y fecha con su recordatorio; «por enviar» en ámbar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_row" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
    <FrameLayout android:id="@+id/task_check" android:layout_width="48dp" android:layout_height="48dp" android:layout_marginStart="-12dp">
        <ImageView android:id="@+id/task_ring" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/widget_w_check" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/task_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Preparar la entrevista" android:textSize="14.5sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/task_bell" android:layout_width="13dp" android:layout_height="13dp" android:layout_marginEnd="4dp" android:src="@drawable/ic_ag_bell"
                android:tint="@color/widget_blue" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/task_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hoy · 1 h antes" android:textSize="12.5sp" android:textColor="@color/widget_text2" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            <ImageView android:id="@+id/task_pend_dot" android:layout_width="7dp" android:layout_height="7dp" android:layout_marginStart="6dp" android:src="@drawable/widget_w_dot_amber"
                android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/task_pend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="por enviar"
                android:textColor="@color/widget_amber_ink" android:textSize="12.5sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
