<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Certificates the user installs in Android (Settings > Security > Install a certificate) are
         trusted too, so a home server with its own certificate works without a custom build. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
