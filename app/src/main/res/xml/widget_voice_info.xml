<?xml version="1.0" encoding="utf-8"?>
<!-- "App Android · widgets y «Oye, Sakura»": nace en 4 × 2 (grande, con los chips de modelos) y se puede achicar a una
     fila (cápsula del modelo y botones redondos). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_large"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
