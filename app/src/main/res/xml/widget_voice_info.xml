<?xml version="1.0" encoding="utf-8"?>
<!-- Widgets Hanami: nace en 4 × 2 (grande, con la fila de modelos y Nuevo chat · Agenda · Notas · Último chat); de una
     fila es el mediano y de 2 × 2 el chico. Cada 30 minutos revisa si tu PC responde («Tu PC no responde»). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_large"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:minResizeWidth="140dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_large"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
